# Domain the calendar is served on (must point to your Traefik host).
DOMAIN=cal.example.com

# Names from your existing Traefik setup.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Image to run; pin a version tag (e.g. :1.0.0) or a digest for reproducible deployments.
IMAGE=ghcr.io/danielgnth/tum-calendar-proxy:latest

# "closed" after your first login: only calendars that logged in once can use the server.
REGISTRATION=open
CACHE_TTL_SECONDS=300
